# Copy to .env for local use. In staging/production these come from AWS Secrets Manager (see infra/terraform).
CALLBRIDGE_ENV=dev
CALLBRIDGE_DATABASE_URL=sqlite:///./callbridge.db
CALLBRIDGE_PUBLIC_BASE_URL=http://localhost:8000
CALLBRIDGE_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# rules = fully offline (no LLM calls). anthropic = Claude for hard turns, GPT backup, Groq for easy turns.
CALLBRIDGE_LLM_PROVIDER=rules
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Voice (needed for real phone calls)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
CALLBRIDGE_TWILIO_SMS_FROM=

# Observability (optional)
SENTRY_DSN=
CALLBRIDGE_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

CALLBRIDGE_DAILY_COST_CAP_GBP=20
